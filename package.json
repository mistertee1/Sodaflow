{
  "name": "sudaflow",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "worker:large-export": "node --import tsx server/largeExportWorkerRunner.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:rules": "node --import tsx --test --test-concurrency=1 tests/firestore.test.ts tests/platformFirestore.test.ts tests/serverAuthorityFirestore.test.ts tests/platformPauseFirestore.test.ts tests/usdReferenceFirestore.test.ts tests/productUniquenessFirestore.test.ts tests/invoiceSaveFirestore.test.ts tests/historicalReviewFirestore.test.ts",
    "test:emulator": "firebase emulators:exec --config firebase.emulator.json --project demo-sudaflow --only firestore \"npm run test:rules\"",
    "test:ui": "node --import tsx node_modules/@playwright/test/cli.js test",
    "check": "npm run lint && npm run lint:core && npm test && npm run test:netlify && npm run build",
    "lint:core": "node scripts/accounting-rules-hash.mjs --check && tsc --project tsconfig.core.json",
    "deploy:firebase:rules": "firebase deploy --only firestore:rules,firestore:indexes --project sodaflow",
    "billing:readiness": "node --import tsx scripts/check-cloud-readiness.ts",
    "billing:migrate": "node --import tsx scripts/migrate-platform-billing.ts",
    "billing:bootstrap": "node --import tsx scripts/bootstrap-platform-admin.ts",
    "build:netlify": "node scripts/check-netlify-runtime.mjs && vite build",
    "test:netlify": "node scripts/check-netlify-runtime.mjs && node --no-experimental-require-module --no-experimental-detect-module --test tests/netlifyRuntime.test.mjs tests/netlifyColdStart.test.mjs tests/jwksRuntime.test.mjs",
    "postinstall": "node scripts/patch-jwks-runtime.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.6",
    "@netlify/functions": "^6.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bignumber.js": "^11.1.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "serverless-http": "^4.0.0",
    "vite": "^6.4.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.32.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1",
    "firebase-admin": {
      "jwks-rsa": "4.1.0"
    },
    "dompurify": "^3.4.17"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
