rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(orgId) {
      return signedIn() && get(/databases/$(database)/documents/organizations/$(orgId)).data.owner_uid == request.auth.uid;
    }
    function active(orgId) {
      return signedIn() && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'active'
        && (owner(orgId) || (get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['Admin', 'Accountant', 'Sales', 'Cashier', 'Viewer']));
    }
    function role(orgId, roles) {
      return active(orgId) && (owner(orgId) && 'Owner' in roles || get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in roles);
    }
    match /organizations/{orgId} {
      allow read: if active(orgId);
      // All domain writes go through the authenticated operations API.
      allow write: if false;
      match /{collection}/{id} {
        allow read: if active(orgId) && (
          collection in ['customers', 'products', 'invoices', 'payments', 'accounts', 'settings']
          || collection == 'members' && (id == request.auth.uid || role(orgId, ['Owner', 'Admin', 'Accountant', 'Sales', 'Viewer']))
          || collection in ['expenses', 'inventory_movements'] && role(orgId, ['Owner', 'Admin', 'Accountant', 'Viewer'])
          || collection == 'journal_entries' && role(orgId, ['Owner', 'Admin', 'Accountant', 'Viewer'])
          || collection in ['audit_logs', 'invitations'] && role(orgId, ['Owner', 'Admin', 'Accountant'])
          || collection == 'meta' && id in ['counters', 'subscription']
        );
        allow write: if false;
      }
    }
    match /user_organizations/{uid}/orgs/{id} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    // Retain read access to legacy records for controlled migration; no bypass for financial writes.
    match /users/{uid}/{path=**} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /{path=**} { allow read, write: if false; }
  }
}
