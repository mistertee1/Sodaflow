{
  "entities": {
    "MerchantSettings": {
      "title": "MerchantSettings",
      "description": "Store configuration, exchange rate, and merchant branding.",
      "type": "object",
      "properties": {
        "business_name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "bank_details": { "type": "string", "maxLength": 300 },
        "default_exchange_rate": { "type": "number" },
        "logo_url": { "type": "string", "maxLength": 500000 },
        "primary_currency": { "type": "string", "enum": ["SDG", "USD"] },
        "secondary_currency": { "type": "string", "enum": ["SDG", "USD"] },
        "sdg_decimals": { "type": "number" },
        "usd_decimals": { "type": "number" },
        "rounding_rule": { "type": "string", "enum": ["round", "ceil", "floor"] },
        "invoice_prefix": { "type": "string", "maxLength": 20 },
        "default_invoice_notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["business_name", "phone", "default_exchange_rate"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer contact and balance record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "preferred_currency": { "type": "string", "enum": ["SDG", "USD"] },
        "balance_sdg": { "type": "number" },
        "balance_usd": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "created_at": { "type": "string", "maxLength": 50 },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "phone"]
    },
    "Product": {
      "title": "Product",
      "description": "Product inventory and pricing item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "unit": { "type": "string", "maxLength": 50 },
        "price_sdg": { "type": "number" },
        "price_usd": { "type": "number" },
        "tax_rate": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "is_active": { "type": "boolean" },
        "stock_quantity": { "type": "number" },
        "min_stock_alert": { "type": "number" },
        "track_inventory": { "type": "boolean" },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "name", "price_sdg", "price_usd"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Commercial invoice with dual currency calculation and frozen exchange rate.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoice_number": { "type": "string", "maxLength": 50 },
        "customer_id": { "type": "string", "maxLength": 128 },
        "customer_name": { "type": "string", "maxLength": 150 },
        "customer_phone": { "type": "string", "maxLength": 50 },
        "customer_address": { "type": "string", "maxLength": 300 },
        "issue_date": { "type": "string", "maxLength": 50 },
        "due_date": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["draft", "sent", "partially_paid", "paid", "overdue", "cancelled"] },
        "currency_mode": { "type": "string", "enum": ["dual", "single_sdg", "single_usd"] },
        "exchange_rate_used": { "type": "number" },
        "items": { "type": "array" },
        "subtotal_sdg": { "type": "number" },
        "subtotal_usd": { "type": "number" },
        "discount_type": { "type": "string", "enum": ["percent", "fixed"] },
        "discount_value": { "type": "number" },
        "discount_total_sdg": { "type": "number" },
        "discount_total_usd": { "type": "number" },
        "tax_total_sdg": { "type": "number" },
        "tax_total_usd": { "type": "number" },
        "grand_total_sdg": { "type": "number" },
        "grand_total_usd": { "type": "number" },
        "paid_amount_sdg": { "type": "number" },
        "paid_amount_usd": { "type": "number" },
        "remaining_sdg": { "type": "number" },
        "remaining_usd": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "payment_instructions": { "type": "string", "maxLength": 500 },
        "created_at": { "type": "string", "maxLength": 50 },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "invoice_number", "customer_name", "exchange_rate_used", "grand_total_sdg", "grand_total_usd"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment receipt for full or partial invoice payment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoice_id": { "type": "string", "maxLength": 128 },
        "invoice_number": { "type": "string", "maxLength": 50 },
        "customer_id": { "type": "string", "maxLength": 128 },
        "customer_name": { "type": "string", "maxLength": 150 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["SDG", "USD"] },
        "exchange_rate_used": { "type": "number" },
        "amount_in_other_currency": { "type": "number" },
        "payment_method": { "type": "string", "enum": ["cash", "bankak", "fawry", "bank_transfer", "other"] },
        "reference_number": { "type": "string", "maxLength": 100 },
        "payment_date": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "invoice_id", "amount", "currency", "payment_method"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operating expense or stock purchase record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["SDG", "USD"] },
        "exchange_rate_used": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "receipt_image": { "type": "string", "maxLength": 500000 },
        "created_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "amount", "currency"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Immutable ledger entry recording product stock changes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "product_id": { "type": "string", "maxLength": 128 },
        "product_name": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["SALE", "PURCHASE", "ADJUSTMENT", "VOID_REVERSAL", "OPENING_BALANCE", "RETURN"] },
        "quantity": { "type": "number" },
        "previous_stock": { "type": "number" },
        "resulting_stock": { "type": "number" },
        "reference_type": { "type": "string", "enum": ["invoice", "audit_adjustment", "manual", "void"] },
        "reference_id": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 300 },
        "created_at": { "type": "string", "maxLength": 50 },
        "created_by": { "type": "string", "maxLength": 128 },
        "operation_id": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "product_id", "type", "quantity", "reference_type", "reference_id"]
    },
    "IdempotencyRecord": {
      "title": "IdempotencyRecord",
      "description": "Deduplication and operation tracking entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 50 },
        "resource_id": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["completed", "failed"] }
      },
      "required": ["id", "action", "resource_id", "status"]
    },
    "Account": {
      "title": "Account",
      "description": "Chart of accounts general ledger account.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 20 },
        "name_ar": { "type": "string", "maxLength": 150 },
        "name_en": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["ASSET", "LIABILITY", "EQUITY", "REVENUE", "EXPENSE"] },
        "nature": { "type": "string", "enum": ["DEBIT", "CREDIT"] },
        "balance_sdg": { "type": "number" },
        "balance_usd": { "type": "number" },
        "org_id": { "type": "string", "maxLength": 128 },
        "is_system": { "type": "boolean" },
        "is_active": { "type": "boolean" }
      },
      "required": ["code", "name_ar", "type", "nature"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Double-entry general ledger voucher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "entry_number": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 },
        "reference_type": { "type": "string" },
        "reference_id": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "total_debit_sdg": { "type": "number" },
        "total_credit_sdg": { "type": "number" },
        "is_balanced": { "type": "boolean" },
        "org_id": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "entry_number", "total_debit_sdg", "total_credit_sdg", "is_balanced"]
    },
    "OrgSubscription": {
      "title": "OrgSubscription",
      "description": "Tenant subscription plan, usage quotas, and active feature flags.",
      "type": "object",
      "properties": {
        "org_id": { "type": "string", "maxLength": 128 },
        "plan": { "type": "string", "enum": ["Free", "Starter", "Professional", "Business", "Enterprise"] },
        "status": { "type": "string", "enum": ["active", "trialing", "past_due", "canceled"] },
        "max_invoices_per_month": { "type": "number" },
        "max_members": { "type": "number" },
        "max_customers": { "type": "number" },
        "max_products": { "type": "number" },
        "created_at": { "type": "string", "maxLength": 50 },
        "updated_at": { "type": "string", "maxLength": 50 }
      },
      "required": ["org_id", "plan", "status", "max_invoices_per_month", "max_members"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "MerchantSettings",
      "description": "The root document for a merchant user, storing their store settings and profile."
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer records created and managed by the authenticated merchant."
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog and inventory balances managed by the authenticated merchant."
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Dual currency invoices with frozen exchange rates created by the merchant."
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment receipts recorded by the merchant against invoices."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business expenses recorded by the merchant."
    },
    "/users/{userId}/inventory_movements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Immutable ledger entries of stock changes."
    },
    "/users/{userId}/idempotency/{operationId}": {
      "schema": "IdempotencyRecord",
      "description": "Financial operation idempotency keys."
    },
    "/organizations/{orgId}": {
      "schema": "MerchantSettings",
      "description": "Root tenant organization document containing business metadata and settings."
    },
    "/organizations/{orgId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Tenant-scoped customer records."
    },
    "/organizations/{orgId}/products/{productId}": {
      "schema": "Product",
      "description": "Tenant-scoped catalog and stock records."
    },
    "/organizations/{orgId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Tenant-scoped dual-currency invoices with frozen FX."
    },
    "/organizations/{orgId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Tenant-scoped payment receipts."
    },
    "/organizations/{orgId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Tenant-scoped operating expenses."
    },
    "/organizations/{orgId}/inventory_movements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Tenant-scoped immutable inventory movements ledger."
    },
    "/organizations/{orgId}/audit_logs/{logId}": {
      "schema": "IdempotencyRecord",
      "description": "Tenant-scoped append-only audit trail logs."
    },
    "/organizations/{orgId}/idempotency/{operationId}": {
      "schema": "IdempotencyRecord",
      "description": "Tenant-scoped idempotency locks."
    },
    "/organizations/{orgId}/accounts/{accountId}": {
      "schema": "Account",
      "description": "Tenant-scoped chart of accounts general ledger accounts."
    },
    "/organizations/{orgId}/journal_entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Tenant-scoped double-entry general ledger journal vouchers."
    },
    "/organizations/{orgId}/members/{memberUid}": {
      "schema": "IdempotencyRecord",
      "description": "Tenant-scoped organization membership and role assignments."
    },
    "/user_organizations/{userId}/orgs/{orgId}": {
      "schema": "IdempotencyRecord",
      "description": "User-to-organization membership index for rapid lookups."
    },
    "/organizations/{orgId}/meta/subscription": {
      "schema": "OrgSubscription",
      "description": "Tenant organization subscription plan, limits, and feature flags."
    }
  }
}
