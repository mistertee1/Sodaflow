rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================================
    // SECURITY HELPER FUNCTIONS
    // ========================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Authoritative check if user is the direct owner of the organization doc
    function isDirectOrgOwner(orgId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/organizations/$(orgId))
        && 'owner_uid' in get(/databases/$(database)/documents/organizations/$(orgId)).data
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.owner_uid == request.auth.uid
        && (!('status' in get(/databases/$(database)/documents/organizations/$(orgId)).data)
            || get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'active')
      );
    }

    // Helper: Check if user has an active membership record in the organization
    function isMemberActive(orgId, uid) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid))
        && 'status' in get(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid)).data
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(uid)).data.status == 'active';
    }

    // Authoritative check if user has an active membership record in the organization
    function isAuthoritativeMember(orgId) {
      return isAuthenticated() && (
        isDirectOrgOwner(orgId)
        || isMemberActive(orgId, request.auth.uid)
      );
    }

    // Check if user has Owner role AND is active
    function isOrgOwner(orgId) {
      return isAuthenticated() && (
        isDirectOrgOwner(orgId)
        || (
          isMemberActive(orgId, request.auth.uid)
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'Owner'
        )
      );
    }

    // Check if user has Owner or Admin role AND is active
    function isOrgOwnerOrAdmin(orgId) {
      return isOrgOwner(orgId) || (
        isMemberActive(orgId, request.auth.uid)
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['Owner', 'Admin']
      );
    }

    // Check if user has one of the specified allowed roles AND is active
    function hasAnyRole(orgId, allowedRoles) {
      return isAuthenticated() && (
        (isOrgOwner(orgId) && ('Owner' in allowedRoles))
        || (
          isMemberActive(orgId, request.auth.uid)
          && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in allowedRoles
        )
      );
    }

    function isOrgMember(orgId) {
      return isAuthoritativeMember(orgId);
    }

    // ========================================================
    // MULTI-TENANT ORGANIZATIONS SCOPE (/organizations/{orgId})
    // ========================================================
    match /organizations/{orgId} {
      // Organization root document
      allow get: if isAuthenticated() && (
        isAuthoritativeMember(orgId)
        || resource == null // Allow checking non-existence during org creation
      );
      allow list: if isAuthenticated() && (
        resource.data.owner_uid == request.auth.uid
      );
      // Organization creation: authenticated user becomes direct owner
      allow create: if isAuthenticated()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.id == orgId;
      // Organization update: Owner/Admin only. Immutable owner_uid and org ID.
      allow update: if isAuthenticated() && isOrgOwnerOrAdmin(orgId)
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.id == resource.data.id;
      allow delete: if false; // Never hard delete an organization

      // 1. Members
      match /members/{memberUid} {
        allow get: if isAuthenticated() && (memberUid == request.auth.uid || isAuthoritativeMember(orgId));
        allow list: if isAuthoritativeMember(orgId);

        // CREATE MEMBER:
        // - Initial direct owner setting their own Owner member record
        // - Org Owner adding any member
        // - Org Admin adding an operational member (cannot add Owner or Admin)
        // - Recipient accepting a valid pending invitation
        allow create: if isAuthenticated() && (
          // Initial direct owner setting their own Owner member record
          (request.auth.uid == memberUid
           && isDirectOrgOwner(orgId)
           && request.resource.data.uid == memberUid
           && request.resource.data.org_id == orgId
           && request.resource.data.role == 'Owner'
           && request.resource.data.status == 'active')
          ||
          // Org Owner adding a member
          (isOrgOwner(orgId)
           && request.resource.data.uid == memberUid
           && request.resource.data.org_id == orgId
           && request.resource.data.status in ['active', 'suspended']
           && request.resource.data.role in ['Owner', 'Admin', 'Accountant', 'Sales', 'Cashier', 'Viewer'])
          ||
          // Org Admin adding an operational member
          (isOrgOwnerOrAdmin(orgId)
           && !isOrgOwner(orgId)
           && request.resource.data.uid == memberUid
           && request.resource.data.org_id == orgId
           && request.resource.data.status in ['active', 'suspended']
           && request.resource.data.role in ['Accountant', 'Sales', 'Cashier', 'Viewer'])
          ||
          // Recipient accepting a valid pending invitation
          (request.auth.uid == memberUid
           && request.resource.data.uid == memberUid
           && request.resource.data.org_id == orgId
           && request.resource.data.status == 'active'
           && 'invitation_id' in request.resource.data
           && exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id))
           && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.status == 'pending'
           // Server-authoritative expiration check:
           && (
             ('expires_at_ts' in get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data
              && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.expires_at_ts is timestamp
              && request.time < get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.expires_at_ts)
             ||
             ('expires_at' in get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data
              && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.expires_at is timestamp
              && request.time < get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.expires_at)
           )
           && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.role == request.resource.data.role
           && (
             (request.auth.token.email != null && (request.auth.token.email == get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.recipient_email || request.auth.token.email.lower() == get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.recipient_email.lower()))
             || get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(request.resource.data.invitation_id)).data.recipient_email.lower() == request.resource.data.email.lower()
           ))
        );

        // UPDATE MEMBER:
        // Members CANNOT update their own role or promote themselves!
        // Immutable identity fields (uid, org_id) CANNOT change!
        allow update: if isAuthenticated() && (
          request.resource.data.uid == resource.data.uid
          && request.resource.data.org_id == resource.data.org_id
          && request.resource.data.status in ['active', 'suspended']
          && (
            // Org Owner can update any member except self-role changes
            (isOrgOwner(orgId) && (
              request.auth.uid != memberUid || request.resource.data.role == resource.data.role
            ))
            ||
            // Admin can update operational roles only (cannot touch Owner or Admin, and cannot promote to Owner or Admin)
            (isOrgOwnerOrAdmin(orgId)
             && !isOrgOwner(orgId)
             && request.auth.uid != memberUid
             && !(resource.data.role in ['Owner', 'Admin'])
             && request.resource.data.role in ['Accountant', 'Sales', 'Cashier', 'Viewer'])
          )
        );

        // DELETE MEMBER:
        // Cannot delete the organization owner
        allow delete: if isAuthenticated() && (
          resource.data.role != 'Owner'
          && (
            isOrgOwner(orgId)
            || (isOrgOwnerOrAdmin(orgId) && !(resource.data.role in ['Owner', 'Admin']))
          )
        );
      }

      // 2. Invitations
      match /invitations/{invId} {
        // List: Only Owner/Admin can list invitations
        // Get: Owner/Admin OR intended recipient
        allow list: if isOrgOwnerOrAdmin(orgId);
        allow get: if isAuthenticated() && (
          isOrgOwnerOrAdmin(orgId)
          || (request.auth.token.email != null && (request.auth.token.email == resource.data.recipient_email || request.auth.token.email.lower() == resource.data.recipient_email.lower()))
        );

        // CREATE: Only Owner or Admin can create invitations
        allow create: if isAuthenticated() && isOrgOwnerOrAdmin(orgId)
          && request.resource.data.org_id == orgId
          && request.resource.data.inviter_uid == request.auth.uid
          && request.resource.data.recipient_email is string
          && request.resource.data.status == 'pending'
          && request.resource.data.created_at is string
          && (
            ('expires_at_ts' in request.resource.data && request.resource.data.expires_at_ts is timestamp && request.resource.data.expires_at_ts > request.time)
            || ('expires_at' in request.resource.data && request.resource.data.expires_at is timestamp && request.resource.data.expires_at > request.time)
          )
          && (
            isOrgOwner(orgId)
              ? request.resource.data.role in ['Admin', 'Accountant', 'Sales', 'Cashier', 'Viewer']
              : request.resource.data.role in ['Accountant', 'Sales', 'Cashier', 'Viewer']
          );

        // UPDATE: Owner/Admin revoking OR recipient accepting (pending -> accepted)
        allow update: if isAuthenticated() && (
          // Owner/Admin revoking/modifying
          (isOrgOwnerOrAdmin(orgId)
           && request.resource.data.org_id == resource.data.org_id
           && request.resource.data.recipient_email == resource.data.recipient_email
           && request.resource.data.role == resource.data.role)
          ||
          // Intended recipient accepting: transition pending -> accepted
          (request.auth.token.email != null
           && (request.auth.token.email == resource.data.recipient_email || request.auth.token.email.lower() == resource.data.recipient_email.lower())
           && resource.data.status == 'pending'
           // Server-authoritative expiration check:
           && (
             ('expires_at_ts' in resource.data && resource.data.expires_at_ts is timestamp && request.time < resource.data.expires_at_ts)
             || ('expires_at' in resource.data && resource.data.expires_at is timestamp && request.time < resource.data.expires_at)
           )
           && request.resource.data.status == 'accepted'
           && request.resource.data.org_id == resource.data.org_id
           && request.resource.data.recipient_email == resource.data.recipient_email
           && request.resource.data.role == resource.data.role
           && request.resource.data.inviter_uid == resource.data.inviter_uid
           && request.resource.data.created_at == resource.data.created_at)
        );

        // DELETE: Only Owner or Admin
        allow delete: if isOrgOwnerOrAdmin(orgId);
      }

      // 3. Settings
      match /settings/{settingDoc} {
        allow read: if isOrgMember(orgId);
        allow write: if isOrgOwnerOrAdmin(orgId);
      }

      // 4. Customers
      match /customers/{customerId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant', 'Sales']);
        allow delete: if isOrgOwnerOrAdmin(orgId);
      }

      // 5. Suppliers
      match /suppliers/{supplierId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow delete: if isOrgOwnerOrAdmin(orgId);
      }

      // 6. Products
      match /products/{productId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow delete: if isOrgOwnerOrAdmin(orgId);
      }

      // 7. Invoices: Immutable historical FX and ID, hard delete forbidden
      match /invoices/{invoiceId} {
        allow read: if isOrgMember(orgId);
        allow create: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant', 'Sales', 'Cashier']);
        allow update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant'])
                      && request.resource.data.id == resource.data.id
                      && request.resource.data.exchange_rate_used == resource.data.exchange_rate_used;
        allow delete: if false;
      }

      // 8. Payments: Receipts cannot be destroyed
      match /payments/{paymentId} {
        allow read: if isOrgMember(orgId);
        allow create: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant', 'Sales', 'Cashier']);
        allow update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow delete: if false;
      }

      // 9. Expenses
      match /expenses/{expenseId} {
        allow read: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow create, update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow delete: if isOrgOwnerOrAdmin(orgId);
      }

      // 10. Purchases
      match /purchases/{purchaseId} {
        allow read: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow create, update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow delete: if false;
      }

      // 11. Inventory Movements: Append-only immutable ledger
      match /inventory_movements/{movementId} {
        allow read: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow create: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant', 'Sales', 'Cashier']);
        allow update, delete: if false;
      }

      // 12. Audit Logs: Append-only immutable audit trail
      match /audit_logs/{logId} {
        allow read: if isOrgOwnerOrAdmin(orgId);
        allow create: if isOrgMember(orgId)
          && request.resource.data.org_id == orgId
          && request.resource.data.actor_uid == request.auth.uid
          && request.resource.data.action is string
          && request.resource.data.created_at is string;
        allow update, delete: if false;
      }

      // 13. Idempotency records: Non-deletable operation locks
      match /idempotency/{operationId} {
        allow read, create: if isOrgMember(orgId);
        allow update, delete: if false;
      }

      // 14. Metadata (e.g. counters, migration markers)
      match /meta/{metaDoc} {
        allow read: if isOrgMember(orgId);
        allow write: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant', 'Sales', 'Cashier']);
      }

      // 15. Real-Time Cashier Sessions
      match /pos_sessions/{sessionId} {
        allow read: if isOrgMember(orgId);
        allow create: if hasAnyRole(orgId, ['Owner', 'Admin', 'Cashier', 'Sales']);
        allow update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Cashier', 'Sales']);
        allow delete: if isOrgOwnerOrAdmin(orgId);
      }

      // 16. POS Shifts
      match /pos_shifts/{shiftId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Cashier']);
        allow delete: if false;
      }

      // 17. Chart of Accounts
      match /accounts/{accountCode} {
        allow read: if isOrgMember(orgId);
        allow create, update: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow delete: if isOrgOwnerOrAdmin(orgId);
      }

      // 18. General Ledger Journal Entries: Append-only immutable accounting ledger
      match /journal_entries/{entryId} {
        allow read: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant']);
        allow create: if hasAnyRole(orgId, ['Owner', 'Admin', 'Accountant', 'Sales', 'Cashier']);
        allow update, delete: if false;
      }
    }

    // ========================================================
    // USER-ORGANIZATIONS INDEX (/user_organizations/{userId})
    // ========================================================
    match /user_organizations/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;

      match /orgs/{orgId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        // Strict index validation: cannot write arbitrary orgs to gain access
        allow create, update: if isAuthenticated() && (
          // Org Owner or Admin of orgId adding this user to their index
          (isOrgOwnerOrAdmin(orgId) && (request.auth.uid == userId || exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(userId))))
          ||
          // User registering an org where they are already the authoritative direct owner or member
          (request.auth.uid == userId && (
            isDirectOrgOwner(orgId)
            || (
              isMemberActive(orgId, userId)
              && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(userId)).data.role == request.resource.data.role
            )
          ))
        );
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId || isOrgOwnerOrAdmin(orgId)
        );
      }
    }

    // ========================================================
    // LEGACY MERCHANT PROFILES (/users/{userId}) - PRESERVED BUT SEPARATE
    // ========================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /invoices/{invoiceId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
                      && request.resource.data.id == resource.data.id
                      && request.resource.data.exchange_rate_used == resource.data.exchange_rate_used;
        allow delete: if false;
      }

      match /inventory_movements/{movementId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /payments/{paymentId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /idempotency/{operationId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      match /meta/{metaDoc} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public contact/support message submissions
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string 
                    && request.resource.data.message is string;
      allow read, update, delete: if false;
    }
  }
}
