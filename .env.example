PORT=3000
# Production uses NODE_ENV=production; development uses the Vite middleware.
# Set credentials in the server environment only. Never use a VITE_ prefix for secrets.
# Prefer workload identity / Application Default Credentials on Google Cloud.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Netlify has no local ADC file by default. Paste the COMPLETE service-account JSON
# as one environment variable (keep it secret; never prefix it with VITE_).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
# Production defaults to the Firebase project's `(default)` Firestore database.
# FIREBASE_PROJECT_ID=your-firebase-project
# FIRESTORE_DATABASE_ID=(default)
# At least 32 random characters; required only to verify paid subscriptions.
# BILLING_SIGNING_SECRET=
