rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.get('email_verified', false) == true; }
    function platformAdmin() {
      return signedIn() && request.auth.token.get('superAdmin', false) == true
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data.role == 'super_admin';
    }
    function organization(orgId) { return get(/databases/$(database)/documents/organizations/$(orgId)).data; }
    function owner(orgId) { return signedIn() && organization(orgId).owner_uid == request.auth.uid; }
    function member(orgId) {
      return signedIn() && (owner(orgId) || (
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['Admin', 'Accountant', 'Sales', 'Cashier', 'Viewer']));
    }
    function role(orgId, roles) {
      return member(orgId) && (owner(orgId) && 'Owner' in roles || get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in roles);
    }
    // Canonical billing fields are server-only. Missing migration data fails closed for protected reads.
    function subscribed(orgId) {
      let org = organization(orgId);
      return member(orgId) && org.status == 'active' && org.get('subscriptionStatus', 'expired') in ['active', 'trial']
        && (org.get('subscriptionEndMillis', null) is int && org.subscriptionEndMillis > request.time.toMillis()
          || org.get('subscriptionEnd', null) == null && org.subscriptionStatus == 'active'
            && (org.get('planId', '') == 'Free' || org.get('subscriptionMetadata', {}).get('legacyNonExpiring', false) == true));
    }
    function feature(orgId, name) {
      let planId = organization(orgId).get('planId', '');
      return subscribed(orgId) && get(/databases/$(database)/documents/plans/$(planId)).data.features.get(name, false) == true;
    }
    match /platformAdmins/{uid} { allow read: if signedIn() && request.auth.uid == uid || platformAdmin(); allow write: if false; }
    match /plans/{planId} { allow read: if signedIn() && (resource.data.active == true || platformAdmin()); allow write: if false; }
    match /subscriptionEvents/{eventId} { allow read: if platformAdmin(); allow write: if false; }
    match /subscriptionRequests/{orgId} { allow read: if platformAdmin() || role(orgId, ['Owner', 'Admin']); allow write: if false; }
    match /organizations/{orgId} {
      allow read: if member(orgId) || platformAdmin();
      allow write: if false;
      match /{collection}/{id} {
        // History stays readable after quota/expiry; commercial admins do not inherit tenant financial access.
        allow read: if member(orgId) && (
          collection in ['customers', 'products', 'invoices', 'payments', 'settings']
          || collection == 'members' && (id == request.auth.uid || role(orgId, ['Owner', 'Admin', 'Accountant', 'Sales', 'Viewer']))
          || collection == 'expenses' && role(orgId, ['Owner', 'Admin', 'Accountant', 'Viewer'])
          || collection == 'inventory_movements' && feature(orgId, 'inventory_tracking') && role(orgId, ['Owner', 'Admin', 'Accountant', 'Viewer'])
          || collection in ['accounts', 'journal_entries'] && feature(orgId, 'accounting') && role(orgId, ['Owner', 'Admin', 'Accountant', 'Viewer'])
          || collection in ['budgets', 'cash_forecast_schedules'] && feature(orgId, 'accounting') && role(orgId, ['Owner', 'Admin', 'Accountant', 'Viewer'])
          || collection == 'branches' && feature(orgId, 'branches')
          || collection in ['cost_centers', 'projects'] && feature(orgId, 'advanced_reports')
          || collection == 'audit_logs' && feature(orgId, 'audit_trail') && role(orgId, ['Owner', 'Admin', 'Accountant'])
          || collection == 'invitations' && role(orgId, ['Owner', 'Admin', 'Accountant'])
          || collection == 'meta' && id in ['counters', 'subscription', 'usage']
          || collection == 'meta' && id == 'subscription_request' && role(orgId, ['Owner', 'Admin'])
        );
        allow write: if false;
      }
    }
    match /user_organizations/{uid}/orgs/{id} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /users/{uid}/{path=**} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /{path=**} { allow read, write: if false; }
  }
}
